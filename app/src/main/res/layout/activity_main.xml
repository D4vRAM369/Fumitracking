<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg">

    <!-- ====== TOP AREA ====== -->
    <FrameLayout
        android:id="@+id/topArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg">

        <!-- Top bar: título, fecha, 3 IconButtons -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="48dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/appTitle"
                    android:maxLines="1"
                    android:ellipsize="end"
                    style="?attr/textAppearanceTitleLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name_description"
                    android:textColor="@color/m3_on_surface" />

                <TextView
                    android:id="@+id/dateText"
                    android:maxLines="1"
                    android:ellipsize="end"
                    style="?attr/textAppearanceLabelMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.55"
                    android:textColor="@color/m3_on_surface" />
            </LinearLayout>

            <!-- Barra superior: solo búsqueda y menú ⋯ (calendario, CSV, tema y ajustes viven en el menú) -->
            <ImageButton
                android:id="@+id/searchButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_top_icon_button"
                android:contentDescription="@string/content_desc_search"
                android:padding="9dp"
                android:src="@android:drawable/ic_menu_search"
                android:tint="@color/m3_on_surface" />

            <ImageButton
                android:id="@+id/moreButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_top_icon_button"
                android:contentDescription="@string/content_desc_more"
                android:padding="9dp"
                android:src="@android:drawable/ic_menu_more"
                android:tint="@color/m3_on_surface" />
        </LinearLayout>

        <!-- Anillos del día: CBD (exterior) y THC (interior), emoji al centro -->
        <LinearLayout
            android:id="@+id/ringsBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="108dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/ringsContainer"
                android:layout_width="180dp"
                android:layout_height="180dp">

                <dev.d4vram.cbdcounter.RingsView
                    android:id="@+id/ringsView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/emojiText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="😌"
                    android:textSize="40sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/cbdCountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/cbdLabelText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="CBD"
                        android:textColor="@color/m3_on_surface_variant"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/thcCountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/thcLabelText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="THC"
                        android:textColor="@color/m3_on_surface_variant"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/ringsHintText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:alpha="0.6"
                android:text="@string/ring_set_goals_hint"
                android:textColor="@color/m3_on_surface"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- TextView oculto para compatibilidad -->
        <TextView
            android:id="@+id/counterText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="0" />
    </FrameLayout>

    <!-- ====== BOTTOM SHEET ====== -->
    <LinearLayout
        android:id="@+id/bottomSheetContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_main_sheet"
        android:elevation="8dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_peekHeight="260dp"
        app:behavior_hideable="false">

        <!-- Handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_sheet_handle" />

        <!-- FAB extendido CBD -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/addInfusedButton"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="16dp"
            android:text="@string/add_infused_label"
            android:textSize="15sp"
            android:textAllCaps="false"
            app:cornerRadius="26dp"
            app:backgroundTint="@color/ring_thc"
            android:textColor="@color/ring_on" />

        <!-- Chip Estadísticas → DashboardActivity -->
        <com.google.android.material.chip.Chip
            android:id="@+id/statsChip"
            style="@style/Widget.MaterialComponents.Chip.Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:text="@string/stats_chip_label"
            android:textSize="14sp"
            android:textAllCaps="false"
            app:chipBackgroundColor="@color/main_stat_tile_bg" />

        <!-- Fila stats -->
        <LinearLayout
            android:id="@+id/statsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/avgText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_main_stat_tile"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:paddingVertical="9dp"
                android:text="@string/avg_placeholder"
                android:textSize="12sp"
                android:textColor="@color/m3_on_surface_variant" />

            <TextView
                android:id="@+id/totalText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_main_stat_tile"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:paddingVertical="9dp"
                android:text="@string/total_placeholder"
                android:textSize="12sp"
                android:textColor="@color/m3_on_surface_variant" />

            <TextView
                android:id="@+id/streakText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_main_stat_tile"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:paddingVertical="9dp"
                android:text="@string/streak_placeholder"
                android:textSize="12sp"
                android:textColor="@color/m3_on_surface_variant" />
        </LinearLayout>

        <!-- Botones de control -->
        <LinearLayout
            android:id="@+id/buttonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/subtractButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/subtract_button_label"
                android:textAllCaps="false"
                android:layout_marginEnd="8dp"
                app:backgroundTint="@color/main_action_tonal_bg"
                app:cornerRadius="18dp"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/add_thc_label"
                android:textAllCaps="false"
                android:layout_marginHorizontal="8dp"
                app:backgroundTint="@color/ring_cbd"
                android:textColor="@color/ring_on"
                app:cornerRadius="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/resetButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/reset_button_label"
                android:textAllCaps="false"
                android:layout_marginStart="8dp"
                app:cornerRadius="18dp" />
        </LinearLayout>

        <!-- Tabs historial -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/main_sheet_bg"
            app:tabMode="fixed"
            app:tabGravity="fill" />

        <!-- RecyclerView historial -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/historyRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
